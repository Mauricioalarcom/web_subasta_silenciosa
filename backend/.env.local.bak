# ===============================================
# 🏠 CONFIGURACIÓN LOCAL - DESARROLLO
# ===============================================
# ⚠️ ESTE ARCHIVO ES SOLO PARA DESARROLLO LOCAL
# NO usar estos valores en producción

# 🗄️ Base de Datos Local
DB_HOST=localhost
DB_PORT=5432
DB_NAME=subasta_silenciosa_local
DB_USER=fatimapacheco
DB_PASSWORD=

# 🔐 JWT
JWT_SECRET=local_jwt_secret_for_development_only_123456789
JWT_EXPIRES_IN=7d

# 🌐 Servidor
NODE_ENV=development
PORT=4000

# 📧 Email (opcional para desarrollo)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=tu_email@gmail.com
EMAIL_PASSWORD=tu_password
EMAIL_FROM=noreply@subasta.local

# ☁️ Cloudinary (puedes usar los mismos de producción o crear otros)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# 🌍 CORS Origins
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# 🔗 URLs de Aplicaciones
ADMIN_PANEL_URL=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3001

# 🔑 OAuth Google (usar las mismas credenciales - ya incluyen localhost)
GOOGLE_CLIENT_ID=tu_google_client_id
GOOGLE_CLIENT_SECRET=tu_google_client_secret

# 🔐 NextAuth (para las apps frontend)
NEXTAUTH_SECRET=local_nextauth_secret_for_development_123456789
NEXTAUTH_URL=http://localhost:3000  # Para admin-panel
