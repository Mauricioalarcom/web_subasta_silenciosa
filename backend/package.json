{
  "name": "subasta-silenciosa-backend",
  "version": "1.0.0",
  "description": "Backend API para la plataforma de subasta silenciosa",
  "main": "src/server.js",
  "scripts": {
    "dev": "NODE_ENV=development nodemon -r dotenv/config src/server.js dotenv_config_path=.env.local",
    "dev:prod": "nodemon src/server.js",
    "start": "node src/server.js",
    "build": "echo 'No build step required for Node.js'",
    "db:migrate": "node src/database/migrate.js",
    "db:seed": "node src/database/seed.js"
  },
  "keywords": [
    "subasta",
    "api",
    "backend"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.12.0",
    "cloudinary": "^1.41.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.1",
    "pg": "^8.11.3",
    "redis": "^4.6.11",
    "socket.io": "^4.6.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
