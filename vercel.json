{
  "version": 2,
  "builds": [
    {
      "src": "admin-panel/package.json",
      "use": "@vercel/next",
      "config": {
        "projectSettings": {
          "framework": "nextjs"
        }
      }
    },
    {
      "src": "public-web/package.json", 
      "use": "@vercel/next",
      "config": {
        "projectSettings": {
          "framework": "nextjs"
        }
      }
    }
  ],
  "routes": [
    {
      "src": "/admin/(.*)",
      "dest": "admin-panel/$1"
    },
    {
      "src": "/(.*)",
      "dest": "public-web/$1"
    }
  ]
}
